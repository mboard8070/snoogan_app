# === Environment & secrets (CRITICAL — never commit) ===
.env
variables.env
*.key
*.pem
secrets/
config/*.key

# === Logs & runtime ===
*.log
nohup.out
dashboard.log

# === Data / temp files ===
*.csv
*.pkl
*.sqlite3
*.db
trade_history.csv
logs/

# === Local scripts ===
*.sh
start-dashboard.sh
stop-dashboard.sh

# === Jupyter ===
.ipynb_checkpoints/
*.ipynb

# === Misc ===
*.bak
*.tmp

# === SNOOGANS APP SPECIFIC ===

# Strategy persistence & state files (contain live positions, PnL, equity history)
strategy_state.json
strategy_15m_state.json
positions.json
positions_15m.json
.current_position.json
daily_pnl.json
equity_history.json
completed_trades.json

# Discord daily flag files (temporary, reset each day)
.greeting_sent_today
.pivots_sent_today
.eod_summary_sent_today

# RAG knowledge directory – contains all closed trade batches for the AI
# (We keep the folder itself in repo if needed, but never the contents)
data/knowledge/
!data/knowledge/.gitkeep  # Optional: add a .gitkeep if you want an empty folder tracked

