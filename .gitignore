# Ignore generated or temporary files managed by the Workbench
.project/*
!.project/spec.yaml
!.project/configpacks

# General ignores
.DS_Store
*.swp
*~
.vscode/
.idea/

# Logs & runtime files
*.log
nohup.out
dashboard.log
*.csv   # any temp data dumps
*.pkl   # pickled models, backtests, etc.

# Secrets & keys (NEVER commit)
*.key
*.pem
secrets/
config/*.key

# Our local scripts & logs
start-dashboard.sh
stop-dashboard.sh
dashboard.log
nohup.out
*.sh

# Streamlit junk
.streamlit/
.streamlit/secrets.toml

# Byte-compiled / optimized / DLL files
venv/
__pycache__/
*.py[cod]
*$py.class
*.pyc
.DS_Store

# Temp directories, notebooks created by jupyterlab
.ipynb_checkpoints
.Trash-*/
.jupyter/
.local/

# Python distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/

# Large AI files
.gguf
*.gguf
*.bin
*.safetensors
models/*.gguf
models/*.bin
models/*.safetensors

wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Large files / data
data/
datasets/
*.h5
*.pth
*.pt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Workbench Project Layout
data/scratch/*
!data/scratch/.gitkeepvariables.env

!data/scratch/.gitkeep